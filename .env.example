# Transmission RPC connection
# Default: http://localhost:9091/transmission/rpc
TRANSMISSION_URL=http://localhost:9091/transmission/rpc

# Transmission RPC credentials (required)
TRANSMISSION_USER=admin
TRANSMISSION_PASS=secret

# HTTP server listen address
# Default: 127.0.0.1:8080 (loopback only; safe default)
# Docker image overrides this to 0.0.0.0:8080.
# Set to 0.0.0.0:8080 to expose on all interfaces when running outside Docker.
LISTEN_ADDR=127.0.0.1:8080

# CORS origin for frontend requests (no wildcard allowed)
# Default: http://localhost:8080
# Set to your frontend URL in production (e.g., https://example.com)
CORS_ORIGIN=http://localhost:8080

# Enable/disable Web UI
# Default: true
WEBUI_ENABLED=true

# Enable/disable Telegram bot
# Default: false
# Requires TELEGRAM_TOKEN to be set when enabled
TELEGRAM_BOT_ENABLED=false

# Telegram bot token (required if TELEGRAM_BOT_ENABLED=true)
# Get token from BotFather: https://t.me/botfather
TELEGRAM_TOKEN=

# Telegram usernames allowed to use the bot (comma-separated, @ prefix optional)
# Required only if TELEGRAM_BOT_ENABLED=true
# Example: johndoe,@janedoe
TELEGRAM_USERS=

# Logging level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Auto file priority: first N files get high priority,
# remaining files get low priority
FILE_PRIORITY_ENABLED=false
FILE_PRIORITY_HIGH_COUNT=3

# Maximum request body size in bytes (applies to /api/rpc, e.g. torrent-add with large metainfo)
# Default: 10485760 (10 MB)
MAX_REQUEST_BODY_BYTES=10485760

# Pre-check "delete local data" checkbox in the delete torrent dialog
# Default: false
DELETE_WITH_DATA=false

# Night Shift: torrents marked via the UI (moon-star button) are started
# only during the configured window and stopped outside of it.
# Both START and END must be HH:MM (00:00..23:59). The window may wrap over
# midnight (e.g. START=23:00, END=07:00). Leave empty to disable the feature.
NIGHT_SHIFT_START=
NIGHT_SHIFT_END=

# How often the scheduler reconciles torrent state against the window.
# Default: 1m
NIGHT_SHIFT_INTERVAL=1m

# Day Shift: same mechanism as Night Shift, but with its own label and window.
# Torrents marked via the UI (sun button) are started only during the configured
# window and stopped outside of it. Leave empty to disable the feature.
# Note: the two schedulers are independent — a torrent marked for both shifts is
# started and stopped in turn when the windows do not overlap.
DAY_SHIFT_START=
DAY_SHIFT_END=

# How often the day-shift scheduler reconciles torrent state against the window.
# Default: 1m
DAY_SHIFT_INTERVAL=1m

# Path to the SQLite database that stores per-torrent notes.
# Default: data/transmitter.db (Docker image: /app/data/transmitter.db)
# The directory is created on startup and must be writable by the app user.
DB_PATH=data/transmitter.db

# Maximum length of a torrent note, in characters.
# Default: 200
TORRENT_NOTE_MAX_LENGTH=200

# How often notes of torrents that no longer exist in Transmission are removed.
# Notes of torrents deleted through Transmitter are removed immediately;
# this sweep catches removals made from other clients.
# Default: 1h
TORRENT_NOTE_CLEANUP_INTERVAL=1h

# Impact: the upload ratio at which a torrent counts as having given back
# everything it took. 1 means it uploaded as much as it downloaded. The UI marks
# such torrents with a trophy; torrents below the target can be filtered out and
# sent to a shift. Stopping them automatically is switched on in the web UI
# (Settings → General), not here.
# Default: 1
IMPACT_TARGET_RATIO=1

# How often torrents are checked against IMPACT_TARGET_RATIO.
# Default: 5m
IMPACT_INTERVAL=5m

# Sentry error reporting. Only error events (with stack traces) are sent —
# performance tracing and profiling are disabled. Leave SENTRY_DSN empty to
# disable Sentry entirely. When SENTRY_DSN is set, SENTRY_ENVIRONMENT is required.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Movie Plugin: recognizes films, cartoons and series by the torrent name,
# shows posters and descriptions from TMDB, renames torrents on disk and keeps
# the "watched" / "missing subtitles" marks. Hidden in the UI while disabled.
# Default: false
MOVIE_PLUGIN_ENABLED=false

# TMDB credentials (required if MOVIE_PLUGIN_ENABLED=true): a v3 API key or a
# v4 read access token, free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TMDB endpoints. Override them to go through a mirror if TMDB is unreachable
# from your network; HTTPS_PROXY is honoured as well.
# Default: https://api.themoviedb.org/3 and https://image.tmdb.org/t/p
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Language of titles and descriptions, as a TMDB locale (en-US, ru-RU, de-DE, ...).
# It also decides the {title} used for renaming.
# Default: en-US
MOVIE_LANGUAGE=en-US

# Recognize torrents added after the plugin was first enabled (right after
# they are added) and, separately, the ones that were there before (gradually,
# in the background).
# Default: true
MOVIE_AUTO_DETECT=true
MOVIE_BACKFILL=true

# Rename the torrent folder (or its only file) right after a confident match:
# exact title and, for movies, a year within one of the release. Renaming is done
# by Transmission (torrent-rename-path), so seeding continues. Only torrents added
# after the plugin was first enabled are renamed automatically; older ones are
# renamed from the card menu only.
# Default: true
MOVIE_AUTO_RENAME=true

# New name of a renamed torrent. Placeholders: {title} (in MOVIE_LANGUAGE),
# {original_title}, {english_title} (falls back to the original title when TMDB
# has no English one), {year}, {season} (S01, series only), {tmdb_id}, {imdb_id},
# {type} (movie or tv). Must contain {title}, {original_title} or {english_title}.
# A series season pack gets "_S01" appended when the template has no {season}.
# Spaces become underscores, characters not allowed on Windows/SMB shares are
# dropped, and a single-file torrent keeps its extension: "Interstellar_(2014)".
# Default: {english_title} ({year})
MOVIE_RENAME_TEMPLATE={english_title} ({year})

# How often the plugin looks for torrents to recognize, and how many it looks up
# per round (keeps TMDB requests low while a large library is backfilled).
# Default: 1m and 10
MOVIE_SCAN_INTERVAL=1m
MOVIE_SCAN_BATCH=10

# Where posters are cached. Default: a "posters" directory next to DB_PATH.
# MOVIE_POSTER_DIR=

# Optional
SONAR_TOKEN=change-me
